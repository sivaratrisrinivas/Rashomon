# API (api/.env, or the rashomon-api service on Render)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Free Gemini API key for image and PDF OCR (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_OCR_MODEL=gemini-2.5-flash
# Exact, comma-separated app origins allowed to call the API (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000
PORT=3001

# App (app/.env.local, or the rashomon service on Render)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public origin of the app, used for auth redirects behind a proxy
SITE_URL=http://localhost:3000
# Set to true only after configuring the Google provider in Supabase
# NEXT_PUBLIC_GOOGLE_AUTH=true
